{
  "name": "unkayos",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "cd src-wasm && npx wasm-pack build --target web --out-dir ../core/wasm/pkg",
    "prebuild": "npm run build:wasm",
    "build": "vite build",
    "build:dist": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scaffold": "node scripts/scaffold-app.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.27.0",
    "fast-check": "^4.1.1",
    "happy-dom": "^17.4.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
