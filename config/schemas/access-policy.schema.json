{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unkayos:access-policy:1",
  "title": "unkayOS access policy",
  "description": "Declarative, deny-by-default policy for the BFF. Bundled validators never resolve remote references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:\\.\\*)?$",
      "maxLength": 128
    },
    "group": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "actions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "effect": { "enum": ["allow", "deny"] },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/action" }
        },
        "subjects": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "groups": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/group" }
        },
        "issuers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "resourceKinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        },
        "models": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        },
        "ownership": { "enum": ["required"] },
        "requireMfa": { "type": "boolean" },
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        }
      }
    }
  }
}
