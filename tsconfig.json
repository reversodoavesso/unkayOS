{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["core/**/*.js", "apps/**/*.js", "main.js", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
